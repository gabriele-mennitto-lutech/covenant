# --- RUNTIME / LOCAL DEVELOPMENT ---
# Covenant SOC INFRA: Node.js su Windows, eventualmente dietro IIS.
# PORT=9991
# DATASERVICE_URL=http://localhost:9992
# FRONTEND_URL=http://localhost:4200
# NODE_ENV=development

# --- LDAP CONFIGURATION ---
AUTH_MODE=ldap
LDAP_SERVER=
LDAP_PORT=
LDAP_USE_TLS=true
LDAP_BASE_DN=
LDAP_GROUP_ADMIN=AM_WINDOWSSITE_ADM
LDAP_GROUP_READONLY=AM_WINDOWSSITE_READ
LDAP_DEFAULT_DOMAIN=
LDAP_NETBIOS_DOMAIN=
LDAP_DEBUG=true

# --- LOCAL AUTH (OPTIONAL; NO DEFAULT PASSWORDS) ---
# Each local role requires its own explicitly configured, non-empty password.
# Without a password that local account is disabled, including hybrid fallback.
# LOCAL_ADMIN_USER=SOCINFRAADM
# LOCAL_ADMIN_PASSWORD=
# LOCAL_READONLY_USER=SOCINFRAREAD
# LOCAL_READONLY_PASSWORD=
AUTH_TOKEN_TTL_MS=28800000

# --- CVE SEARCH (cve-search / CIRCL) ---
CVE_SEARCH_URL=https://cve.circl.lu
CVE_SEARCH_TIMEOUT_MS=10000
